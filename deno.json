{
  "name": "@scribe/builder",
  "version": "1.0.0",
  "exports": {
    ".": "./mod.ts",
    "./tools": "./tools.ts"
  },
  "tasks": {
    "check": "deno check mod.ts tools.ts src tests",
    "test": "deno test --allow-read --allow-write tests",
    "lint": "deno lint",
    "fmt": "deno fmt"
  },
  "fmt": {
    "lineWidth": 120
  },
  "imports": {
    "@std/assert": "jsr:@std/assert@1",
    "@std/path": "jsr:@std/path@1",
    "@std/yaml": "jsr:@std/yaml@1"
  }
}
