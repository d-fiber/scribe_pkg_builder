{
  "name": "@scribe/builder",
  "version": "3.0.0",
  "exports": {
    "./tools": "./tools.ts"
  },
  "tasks": {
    "check": "deno check tools.ts src tests",
    "test": "deno test --allow-read --allow-write tests",
    "lint": "deno lint",
    "fmt": "deno fmt",
    "example": "deno run --allow-read --allow-write examples/build.ts",
    "example:test": "deno task example && deno test --no-config --import-map examples/.scribe/imports.json examples/app examples/packages"
  },
  "fmt": {
    "lineWidth": 120
  },
  "imports": {
    "@scribe/alchemy": "../scribe_alchemy/mod.ts",
    "@std/assert": "jsr:@std/assert@1",
    "@std/path": "jsr:@std/path@1",
    "@std/yaml": "jsr:@std/yaml@1"
  },
  "publish": {
    "exclude": [
      "tests",
      "examples",
      "tool",
      ".github",
      ".githooks",
      "CONTRIBUTING.md",
      "STYLE.md",
      "TESTING.md"
    ]
  }
}
